# The hosted vision endpoint the photo reviewer calls. Copy this file to
# .env.local and fill in your own values — .env* is gitignored, and neither name
# is NEXT_PUBLIC_, so neither reaches the browser bundle.

# Your Hugging Face Inference Endpoint, without a trailing /v1.
HF_ENDPOINT_URL=https://<id>.<region>.aws.endpoints.huggingface.cloud

# A token with read access to that endpoint.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
