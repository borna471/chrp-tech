# The hosted vision endpoint the photo reviewer calls. Copy this file to
# .env.local and fill in your own values — .env* is gitignored, and neither name
# is NEXT_PUBLIC_, so neither reaches the browser bundle.

# Your Hugging Face Inference Endpoint, without a trailing /v1.
HF_ENDPOINT_URL=https://<id>.<region>.aws.endpoints.huggingface.cloud

# A token with read access to that endpoint.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# The insurer-side mirror. Leave NEXT_PUBLIC_MIRROR_ENABLED unset to run the app
# exactly as it was before the mirror existed — nothing is copied anywhere.

SUPABASE_URL=https://<project>.supabase.co

# The service-role key, not the anon key: it bypasses row-level security, which
# is what lets the mirror routes write to tables nothing else can reach. It is
# read only in lib/server/supabase.ts and must never be given a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_MIRROR_ENABLED=true


# The insurer-side admin at /admin. Unset locally means the gate is open; set it
# in the deployment, where /admin would otherwise list real home addresses.
ADMIN_PASSWORD=

# Only needed when the public origin differs from the host Next sees. Left unset,
# invite links are built from the incoming request, which is correct in
# development and on Vercel.
# APP_URL=https://<project>.vercel.app
